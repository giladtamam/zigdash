# Add to the host's Caddyfile (Caddy must be on the EDGE_NETWORK).
relay.zigdash.app {
	handle /mqtt* {
		reverse_proxy zigdash-relay-mosquitto-1:9001
	}
	# The verifier's internal routes live on another port (8788); never here.
	handle /v1/internal/* {
		respond 404
	}
	handle /v1/* {
		reverse_proxy zigdash-relay-verifier-1:8787
	}
	respond 404
}
