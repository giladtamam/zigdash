<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Last-known tile values stay on this phone: not in cloud
     backup, not in device-to-device transfer (docs/adr/0004). Everything
     else keeps the default behaviour. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/last_known.sqlite" />
        <exclude domain="root" path="app_flutter/last_known.sqlite-wal" />
        <exclude domain="root" path="app_flutter/last_known.sqlite-shm" />
        <exclude domain="root" path="app_flutter/last_known.sqlite-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/last_known.sqlite" />
        <exclude domain="root" path="app_flutter/last_known.sqlite-wal" />
        <exclude domain="root" path="app_flutter/last_known.sqlite-shm" />
        <exclude domain="root" path="app_flutter/last_known.sqlite-journal" />
    </device-transfer>
</data-extraction-rules>
