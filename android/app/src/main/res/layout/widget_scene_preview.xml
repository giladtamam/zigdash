<?xml version="1.0" encoding="utf-8"?>
<!-- The scene widget's preview in the launcher's widget list (the widget
     itself draws widget_device / widget_device_strip with its scene). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_frame"
    android:orientation="vertical"
    android:padding="14dp">
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/w_ic_scene" />
    <!-- Spacer: widgets allow only some view classes (no plain View). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:text="@string/widget_scene_sample"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/w_ink"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:text="@string/widget_scene_sample_line"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/w_ink2"
        android:textSize="12sp" />
</LinearLayout>
