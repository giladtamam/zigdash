<?xml version="1.0" encoding="utf-8"?>
<!-- A shutter's widget (2×2): name and state open the slider pop-up; a bar
     shows the position; ▲ ■ ▼ open, stop and close (widgets can't hold
     sliders). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_frame"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/w_ic_cover" />
        <TextView
            android:id="@+id/w_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_ink2"
            android:textSize="12sp" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/w_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progressTint="@color/w_amber" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_up"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/w_button"
            android:padding="6dp"
            android:src="@drawable/w_ic_up" />
        <ImageView
            android:id="@+id/w_stop"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/w_button"
            android:padding="8dp"
            android:src="@drawable/w_ic_stop" />
        <ImageView
            android:id="@+id/w_down"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/w_button"
            android:padding="6dp"
            android:src="@drawable/w_ic_down" />
    </LinearLayout>
</LinearLayout>
