<?xml version="1.0" encoding="utf-8"?>
<!-- One-device widget, square (2×2): icon, name, state line. The whole
     widget is the switch; it turns amber when the device is on. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_frame"
    android:orientation="vertical"
    android:padding="14dp">
    <ImageView
        android:id="@+id/w_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/w_ic_light" />
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/w_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/w_ink"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/w_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/w_ink2"
        android:textSize="12sp" />
</LinearLayout>
